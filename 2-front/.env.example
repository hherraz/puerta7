# Dirección del contrato Entrada desplegado en la red que uses.
# Para Hardhat local: pnpm --filter @puerta7/hardhat nodo
# Para Sepolia/Base: completá con la dirección de tu deploy
NEXT_PUBLIC_CONTRATO_ENTRADA=0x0000000000000000000000000000000000000000

# Chain ID de la red objetivo (31337 = Hardhat local)
NEXT_PUBLIC_CHAIN_ID=31337

# Opcional: nombre del evento mostrado en el Hero
NEXT_PUBLIC_NOMBRE_EVENTO=Puerta 7

# WalletConnect / Reown projectId (obtenelo en https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
