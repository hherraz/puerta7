# =============================================================================
# Variables de entorno de Puerta 7 (front)
#
# Las DIRECCIONES DE LOS CONTRATOS ya no se configuran acá: salen de
# `src/lib/direcciones.ts`, que genera
#
#     pnpm --filter @puerta7/hardhat exportar
#
# leyendo `ignition/deployments/chain-31337/deployed_addresses.json`.
#
# Escribirlas a mano era una fuente de errores: la dirección del front se
# despegaba de la del deploy y los hooks leían contra un contrato vacío.
# =============================================================================

# Opcional: nombre del evento mostrado en el Hero.
NEXT_PUBLIC_NOMBRE_EVENTO=Puerta 7

# Opcional: WalletConnect / Reown projectId (https://cloud.reown.com).
# Sin esto, RainbowKit muestra el botón "otores wallet" deshabilitado.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Para desplegar en otra red hace falta:
#
#   1. Agregar la red a `src/lib/wagmi.ts` con su `http()` transport.
#   2. Desplegar con `hardhat ignition deploy ... --network <red>`.
#   3. Correr `exportar` con esa red: el archivo `direcciones.ts` gana una
#      entrada más en `DIRECCIONES`, keyed por chain ID.
#
# La app bloquea toda acción fuera de la red para la que hay deploy: ver
# `src/components/web3/AvisoRed.tsx`.
# ---------------------------------------------------------------------------